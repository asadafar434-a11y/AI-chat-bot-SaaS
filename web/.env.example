# Stage 11 — пример переменных окружения. Только плейсхолдеры, реальных секретов здесь нет.
# Файл `.env` игнорируется Git; этот файл — образец, его копируют: cp .env.example .env
# Реальные секреты в production поставляются через переменные окружения или Docker secrets
# и никогда не коммитятся.

# ── PostgreSQL (этап S1) ────────────────────────────────────────────────────────
# Строка подключения к базе приложения. Локально поднимается из docker-compose.postgres.yml.
# В production: приватная сеть РФ, доступ к БД из интернета закрыт.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Пул соединений. Несколько процессов (app, worker) делят лимит сервера, поэтому
# значение задаётся осознанно, а не «по умолчанию». Учитывается на этапе S8.
DATABASE_POOL_MAX="10"

# Уровень логирования Prisma: info | warn | error. Значения запросов в лог не пишутся.
DATABASE_LOG_LEVEL="warn"

# ── EIS Collector v1 (сбор RAW/SILVER dataset закупок) ─────────────────────────
# Подробности: web/src/server/eis/README.md. Только плейсхолдеры, секретов нет.
#
# Схема авторизации логин/пароль и client_credentials официальной документацией
# СОИ НЕ подтверждена (TODO в README модуля): рабочим секретом является ТОКЕН
# потребителя машиночитаемых данных (PMD):
#   https://zakupki.gov.ru/pmd/auth/welcome («Инструкция по использованию
#   сервисов отдачи информации ЕИС для ЮЛ и ФЛ»).
# EIS_AUTH_TOKEN=""            # токен PMD (физлицо: individualPerson_token)
# EIS_BASE_URL=""              # default: https://int44.zakupki.gov.ru/eis-integration/services/getDocsIP (UNCONFIRMED, см. README)
# EIS_USERNAME=""              # НЕПОДТВЕРЖДЕНО: официальной схемы логин/пароль для discovery нет (TODO)
# EIS_PASSWORD=""              # НЕПОДТВЕРЖДЕНО: см. выше
# EIS_CLIENT_ID=""             # НЕПОДТВЕРЖДЕНО: официальной схемы client_credentials нет (TODO)
# EIS_CLIENT_SECRET=""         # НЕПОДТВЕРЖДЕНО: см. выше
# EIS_DRY_RUN="1"              # 1 = только план без скачивания (default); 0 = реальный сбор
# EIS_MAX_TENDERS="100"        # default 100; hard cap v1 = 1000 (10k/50k запрещены)
# EIS_REGION=""                # код региона заказчика, например 77
# EIS_DOC_TYPE=""              # тип документа СОИ по официальной XSD, например epNotificationEF2020
# EIS_REQUEST_DELAY_MS="1000"  # пауза между закупками (rate limit)
# EIS_MAX_RETRIES="3"          # повторы при 429/5xx (0..10)
# EIS_TIMEOUT_MS="30000"       # timeout одного HTTP-запроса
# EIS_STORAGE_PATH="./data"    # корень dataset (raw/, normalized/, progress.json)
# EIS_LIVE_TEST=""             # live smoke test: только при EIS_LIVE_TEST=1 (default выключен)
# ── EIS Document Intelligence (извлечение структуры документов) ─────────────────
# Подробности: web/src/server/eis/extract/README.md (раздел в README модуля EIS).
# EIS_OCR_PROVIDER="none"      # none (default: сканы → ocr_required/OCR_NOT_CONFIGURED) | anthropic (opt-in, нужен ANTHROPIC_API_KEY)
# ── Этапы S2–S9 и production ───────────────────────────────────────────────────
# Плейсхолдеры ниже читаются на этапах S2–S9; обязательные для production помечены.
# Полное описание и значения по умолчанию — в web/README.md и docs/stage-11/.
#
# SERVER_READS — серверные эндпоинты чтения (/api/reads/*) включены только при 1 (этап S4/S11).
# NEXT_PUBLIC_SERVER_READS — клиентское чтение с сервера; по умолчанию включено,
#   значение 0 оставляет legacy-чтение IndexedDB (тесты/dev). Production: не задавать 0 (этап S11).
# SERVER_WRITES / NEXT_PUBLIC_SERVER_WRITES — S5 dual-write, включаются значением 1.
#
# AUTH_SECRET            — подпись/шифрование сессий Auth.js (этап S2)
# AUTH_URL               — публичный адрес приложения (этап S2)
# ACCESS_PASSWORD        — переходный вход по общему паролю, этапы A–C (этап S2)
# S3_ENDPOINT            — адрес S3-совместимого хранилища в РФ (этап S6)
# S3_REGION              — регион бакета (этап S6)
# S3_BUCKET              — имя приватного бакета (этап S6)
# S3_ACCESS_KEY_ID       — доступ к бакету (этап S6)
# S3_SECRET_ACCESS_KEY   — доступ к бакету (этап S6)
# S3_SIGNED_URL_TTL_SECONDS — срок подписанной ссылки, единицы минут (этап S6)
# STORAGE_BACKEND        — s3 (production) или fs (только dev/test) (этап S6)
# S3_FORCE_PATH_STYLE    — 1 для path-style URL, 0 для virtual-hosted (этап S6)
# STORAGE_FS_DIR         — корень fs-бэкенда, только dev/test (этап S6)
# STORAGE_FS_SECRET      — HMAC-секрет локальных ссылок, только dev/test (этап S6)
# STORAGE_FS_ALLOW_PRODUCTION — 1 разрешает fs-бэкенд под NODE_ENV=production для staging/smoke, не для боя (этап S6)
# STORAGE_ENABLED        — 1 включает файловые endpoints, по умолчанию выключены (этап S6)
# PGBOSS_DATABASE_URL    — соединение с той же БД, схема pgboss (этап S8)
# JOBS_ENABLED           — 1 включает фоновые задачи (pg-boss); по умолчанию выключены (этап S8)
# JOBS_DATABASE_URL      — соединение для очереди; по умолчанию берётся DATABASE_URL (этап S8)
# JOBS_SCHEMA            — схема pg-boss, по умолчанию pgboss (этап S8)
# JOBS_POLL_INTERVAL_MS  — базовый интервал опроса очереди, мс (этап S8)
# JOBS_MAX_RETRIES       — лимит попыток по умолчанию (этап S8)
# BACKUP_DIR             — каталог артефактов backup (этап S9)
# BACKUP_DATABASE        — имя БД-источника для backup (этап S9)
# BACKUP_ENCRYPTION_KEY  — hex 64 (32 байта), ключ шифрования payload backup; не в артефакте (этап S9)
# BACKUP_PG_CONTAINER    — docker-контейнер PostgreSQL для pg_dump/psql в dev (этап S9)
# BACKUP_PG_USER         — пользователь БД для docker-режима, по умолчанию postgres (этап S9)
# YOOKASSA_SHOP_ID       — магазин ЮKassa (этап S10)
# YOOKASSA_SECRET_KEY    — магазин ЮKassa (этап S10)
